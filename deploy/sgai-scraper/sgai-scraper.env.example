# Copiare in /etc/sgai-scraper/sgai-scraper.env (chmod 600).
MEF_SCRAPER_UPLOAD=1
SGAI_BASE_URL=https://sgailegal.com
SGAI_SCRAPER_API_TOKEN=
SGAI_WAKE_URL=https://91k2hfw1n3.execute-api.eu-north-1.amazonaws.com/wake-up
SGAI_WAKE_TARGET=SGAI-Production
MEF_SCRAPER_OUTPUT=/var/lib/sgai-scraper/spool
MEF_SCRAPER_TMP=/var/lib/sgai-scraper/tmp
MEF_SCRAPER_CHECKPOINT=/var/lib/sgai-scraper/checkpoint.json
MEF_SCRAPER_QUEUE=/var/lib/sgai-scraper/upload_queue.sqlite3
MEF_SCRAPER_STATE=/var/lib/sgai-scraper/state.json
MEF_SCRAPER_LOCK=/run/sgai-scraper/service.lock
MEF_SCRAPER_BROWSER_PROFILE=/var/lib/sgai-scraper/chromium-profile
MEF_SCRAPER_START_URL=
MEF_SCRAPER_BROWSER_HEADLESS=1
PLAYWRIGHT_BROWSERS_PATH=/opt/sgai-scraper/ms-playwright
MEF_SCRAPER_UPLOAD_BATCH=1
MEF_SCRAPER_MAX_ATTEMPTS=8
MEF_SCRAPER_MAX_SPOOL_BYTES=21474836480
MEF_SCRAPER_MIN_FREE_BYTES=2147483648
