[Unit]
Description=SGAI MEF scraper worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sgai-scraper
Group=sgai-scraper
WorkingDirectory=/opt/ragflow
EnvironmentFile=/etc/sgai-scraper/sgai-scraper.env
ExecStart=/opt/sgai-scraper/venv/bin/python -m scripts.scraper_mef service
Restart=on-failure
RestartSec=30
TimeoutStopSec=120
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sgai-scraper /run/sgai-scraper

[Install]
WantedBy=multi-user.target
